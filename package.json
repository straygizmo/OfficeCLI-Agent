{
  "name": "officecli-agent",
  "private": true,
  "version": "0.1.0",
  "description": "VSTO add-in (Word/Excel/PowerPoint) with a GitHub Copilot SDK agent and OfficeCLI-powered document editing",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --filter ./packages/protocol --filter ./packages/host --filter ./packages/ui build",
    "typecheck": "pnpm -r typecheck",
    "dev:host": "pnpm --filter @officecli-agent/host dev",
    "dev:ui": "pnpm --filter @officecli-agent/ui dev",
    "start": "pnpm --filter @officecli-agent/host start -- --serve-ui"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
