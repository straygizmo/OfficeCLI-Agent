<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared, VSTO-independent code: settings, host process management, the
    WebSocket relay to the Node host and the WebView2 task-pane control.
    Referenced by the three VSTO add-in projects.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>OfficeCliAgent.Core</RootNamespace>
    <AssemblyName>OfficeCliAgent.Core</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.1.2</Version>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2739.15" />
  </ItemGroup>

</Project>
